<UserControl x:Class="PhungLocCoffee_POS.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:PhungLocCoffee_POS"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:CategoryBackgroundConverter x:Key="CategoryBackgroundConverter"/>
        <local:CategoryForegroundConverter x:Key="CategoryForegroundConverter"/>
        <local:ProductBackgroundConverter x:Key="ProductBackgroundConverter"/>
        <local:ProductForegroundConverter x:Key="ProductForegroundConverter"/>
        <local:ProductCursorConverter x:Key="ProductCursorConverter"/>
        <local:StrikethroughConverter x:Key="StrikethroughConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:PaymentMethodBackgroundConverter x:Key="PaymentMethodBackgroundConverter"/>
        <local:PaymentMethodForegroundConverter x:Key="PaymentMethodForegroundConverter"/>

        <DataTemplate x:Key="CategoryTemplate">
            <Border Background="{Binding IsSelected, Converter={StaticResource CategoryBackgroundConverter}}"
                    CornerRadius="12" Padding="0,15" Margin="5,0" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#D7A16A"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" 
                                  Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <TextBlock Text="{Binding Name}" 
                           Foreground="{Binding IsSelected, Converter={StaticResource CategoryForegroundConverter}}"
                           FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProductTemplate">
            <Button Width="170" Height="110" Margin="0,0,15,15"
            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
            CommandParameter="{Binding}"
            Cursor="{Binding IsOutOfStock, Converter={StaticResource ProductCursorConverter}}"
            Background="Transparent" BorderThickness="0" Padding="0">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{Binding IsOutOfStock, Converter={StaticResource ProductBackgroundConverter}}"
                        CornerRadius="16" Padding="15"
                        RenderTransformOrigin="0.5,0.5">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.04" Color="Black"/>
                            </Border.Effect>

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" 
                       FontWeight="Bold" FontSize="16" 
                       Foreground="{Binding IsOutOfStock, Converter={StaticResource ProductForegroundConverter}}"
                       TextDecorations="{Binding IsOutOfStock, Converter={StaticResource StrikethroughConverter}}"
                       TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}" 
                       FontWeight="Black" FontSize="18" Foreground="#D7A16A" Margin="0,8,0,0"
                       Visibility="{Binding IsOutOfStock, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <Border Background="#FED7D7" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Visibility="{Binding IsOutOfStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="HẾT NGUYÊN LIỆU" FontSize="11" Foreground="#E53E3E" FontWeight="Black"/>
                    </Border>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CartItemTemplate">
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" Foreground="#2D3748" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#F7FAFC" CornerRadius="8" Height="32" Width="85" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="-" Background="Transparent" BorderThickness="0" 
                                Foreground="#718096" FontWeight="Bold" FontSize="16" Padding="0"
                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontWeight="Black" FontSize="14" Foreground="#2D3748" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="+" Background="Transparent" BorderThickness="0" 
                                Foreground="#D7A16A" FontWeight="Bold" FontSize="16" Padding="0"
                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding SubTotal, StringFormat={}{0:N0}}" 
                           FontWeight="Bold" FontSize="15" Foreground="#2D3748" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="15,0,15,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Categories}" Margin="0,0,0,20" ItemTemplate="{StaticResource CategoryTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Products}" ItemTemplate="{StaticResource ProductTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" Background="White" CornerRadius="20" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.05" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ĐƠN HÀNG HIỆN TẠI" FontSize="16" FontWeight="Black" Foreground="#2D3748" Margin="0,0,0,15"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding Cart}" ItemTemplate="{StaticResource CartItemTemplate}"/>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <Separator Background="#E2E8F0" Margin="0,15"/>

                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="TỔNG THANH TOÁN" FontSize="16" FontWeight="Black" Foreground="#2D3748" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" 
                                           FontWeight="Black" FontSize="26" Foreground="#D7A16A" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding IsCashSelected, Converter={StaticResource PaymentMethodBackgroundConverter}}"
                                        CornerRadius="10" Padding="0,15" Margin="0,0,5,0" Cursor="Hand"
                                        MouseLeftButtonUp="SelectCash_Click">
                                    <TextBlock Text="TIỀN MẶT" 
                                               Foreground="{Binding IsCashSelected, Converter={StaticResource PaymentMethodForegroundConverter}}"
                                               FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1" Background="{Binding IsTransferSelected, Converter={StaticResource PaymentMethodBackgroundConverter}}"
                                        CornerRadius="10" Padding="0,15" Margin="5,0,0,0" Cursor="Hand"
                                        MouseLeftButtonUp="SelectTransfer_Click">
                                    <TextBlock Text="MÃ QR / CK" 
                                               Foreground="{Binding IsTransferSelected, Converter={StaticResource PaymentMethodForegroundConverter}}"
                                               FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Button Height="60" Background="#D7A16A" BorderThickness="0" Cursor="Hand" 
                                    md:ButtonAssist.CornerRadius="12"
                                    Command="{Binding CheckoutCommand}"
                                    IsEnabled="{Binding IsNotLoading}">
                                <Grid>
                                    <TextBlock Text="THANH TOÁN &amp; TRỪ KHO" FontWeight="Black" FontSize="16" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsNotLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <icon:PackIconMaterial Kind="Refresh" Foreground="White" Width="20" Height="20" Spin="True"/>
                                        <TextBlock Text="ĐANG XỬ LÝ..." FontWeight="Black" FontSize="16" Foreground="White" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="OfflineBanner"
            Grid.Row="1"
            Background="#FFF5F5"
            CornerRadius="12"
            Padding="20,0"
            BorderBrush="#FED7D7"
            BorderThickness="1"
            Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <icon:PackIconMaterial Kind="WifiOff" Foreground="#E53E3E" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="TRẠNG THÁI: OFFLINE (MẤT KẾT NỐI SERVER)" FontWeight="Black" FontSize="13" Foreground="#E53E3E" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Đang lưu tạm thiết bị: " FontWeight="Bold" FontSize="13" Foreground="#C53030"/>
                        <Border Background="#E53E3E" CornerRadius="6" Padding="8,2" Margin="5,0,0,0">
                            <TextBlock Text="{Binding PendingOrderCount, StringFormat={}{0} ĐƠN}" FontWeight="Black" FontSize="12" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="QrPopup" Placement="Center" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="White" CornerRadius="20" Padding="25" BorderBrush="#D7A16A" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="QUÉT MÃ QR ĐỂ THANH TOÁN" FontWeight="Black" FontSize="16" Foreground="#2D3748" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <Image x:Name="QrCodeImage" Width="250" Height="250" Stretch="Uniform"/>
                    <TextBlock Text="Số tiền: " FontWeight="Bold" Margin="0,15,0,5" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="QrAmount" FontWeight="Black" FontSize="20" Foreground="#D7A16A" HorizontalAlignment="Center"/>
                    <Button Content="ĐÃ THANH TOÁN" Background="#D7A16A" Foreground="White" FontWeight="Bold" 
                            md:ButtonAssist.CornerRadius="10" Padding="20,8" Margin="0,20,0,0" Cursor="Hand" Click="CloseQrPopup_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>