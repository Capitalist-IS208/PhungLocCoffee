<UserControl x:Class="PhungLocCoffee_POS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Grid Margin="15,0,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="10" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.03" Color="Black"/>
            </Border.Effect>
            <UniformGrid Columns="3">
                <Border x:Name="btnTab1" Background="#D7A16A" CornerRadius="12" Padding="0,15" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="BtnTab1_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <icon:PackIconMaterial x:Name="iconTab1" Kind="ArchiveOutline" Foreground="White" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTab1" Text="TỒN KHO HIỆN TẠI" Foreground="White" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="btnTab2" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="0,15" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="BtnTab2_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <icon:PackIconMaterial x:Name="iconTab2" Kind="ClipboardCheckOutline" Foreground="#718096" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTab2" Text="KIỂM KHO NHANH" Foreground="#718096" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="btnTab3" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="0,15" Cursor="Hand" MouseLeftButtonUp="BtnTab3_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <icon:PackIconMaterial x:Name="iconTab3" Kind="SwapHorizontal" Foreground="#718096" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTab3" Text="NHẬP / XUẤT / CHUYỂN" Foreground="#718096" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <TabControl x:Name="MainTab" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="15,10" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Magnify" Foreground="#A0AEC0" VerticalAlignment="Center" Width="20" Height="20"/>
                            <TextBox x:Name="txtSearch" md:TextFieldAssist.DecorationVisibility="Collapsed" md:HintAssist.Hint="Tìm kiếm tên nguyên liệu..." md:HintAssist.IsFloating="False" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#2D3748" FontSize="14" Width="300"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="20">
                        <DataGrid x:Name="dgInventory" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="55" FontSize="14" Foreground="#2D3748">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#A0AEC0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Padding" Value="10,0,0,15"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ NL" Binding="{Binding ID}" Width="90"/>
                                <DataGridTextColumn Header="TÊN NGUYÊN LIỆU" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="ĐƠN VỊ" Binding="{Binding Unit}" Width="100"/>
                                <DataGridTextColumn Header="TỒN KHO" Binding="{Binding CurrentQty}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Black"/>
                                            <Setter Property="FontSize" Value="16"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBgColor}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusTextColor}" FontWeight="Black" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <Border Background="White" CornerRadius="20" Padding="40,35" VerticalAlignment="Top" HorizontalAlignment="Center" Width="600" Margin="0,20,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.05" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>

                            <StackPanel Margin="0,0,0,30">
                                <TextBlock Text="Chọn nguyên liệu cần kiểm kê" Foreground="#4A5568" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                <ComboBox x:Name="cboMaterial"
                                 SelectionChanged="CboMaterial_SelectionChanged"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 Foreground="#2D3748"
                                 FontSize="15"
                                 Padding="15,10"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tồn kho hệ thống" Foreground="#718096" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Border Background="#EDF2F7" CornerRadius="8" Padding="15,10" BorderThickness="1" BorderBrush="#E2E8F0">
                                        <TextBlock x:Name="txtSystemQty" Text="" Foreground="#4A5568" FontWeight="Black" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số lượng đếm thực tế" Foreground="#4A5568" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Border BorderBrush="#8993A4" BorderThickness="1" CornerRadius="4" Padding="15,10" Background="White">
                                        <TextBox x:Name="txtActualQty" md:TextFieldAssist.DecorationVisibility="Collapsed" md:HintAssist.IsFloating="False" Text="" Foreground="#2D3748" FontWeight="Black" FontSize="18" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Background="#FFF5F5" CornerRadius="12" Padding="20,15" Margin="0,0,0,35" BorderBrush="#FEB2B2" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <icon:PackIconMaterial Kind="ScaleBalance" Foreground="#E53E3E" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="Độ chênh lệch:" Foreground="#E53E3E" FontWeight="Medium" FontSize="14" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtDiscrepancy" Text="" Foreground="#E53E3E" FontWeight="Black" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtUnitLabel" Text="" Foreground="#E53E3E" FontWeight="Medium" FontSize="14" VerticalAlignment="Center" Margin="5,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnSaveInventory" Click="BtnSaveInventory_Click" Height="50" Width="280" HorizontalAlignment="Center" Background="#D7A16A" BorderThickness="0" Cursor="Hand" md:ButtonAssist.CornerRadius="25">
                                <TextBlock Text="LƯU KIỂM KHO" FontWeight="Black" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <Border Background="White" CornerRadius="20" Padding="40,35" VerticalAlignment="Top" HorizontalAlignment="Center" Width="650" Margin="0,20,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.05" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="1. Loại hình giao dịch" Foreground="#4A5568" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="cboTransType" Style="{StaticResource MaterialDesignOutlinedComboBox}" Foreground="#2D3748" FontSize="15" Padding="15,10">
                                        <ComboBoxItem Content="Nhập hàng hóa"/>
                                        <ComboBoxItem Content="Xuất hủy (Hư hỏng)"/>
                                        <ComboBoxItem Content="Chuyển chi nhánh"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="2. Chi nhánh nhận (Nếu có)" Foreground="#4A5568" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="cboBranch"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Foreground="#2D3748"
                                      FontSize="15"
                                      Padding="15,10"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="3. Chọn nguyên liệu cần xử lý" Foreground="#4A5568" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                <ComboBox x:Name="cboMaterialTrans"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="#2D3748"
                                  FontSize="15"
                                  Padding="15,10"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="4. Số lượng" Foreground="#4A5568" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                <Border BorderBrush="#8993A4" BorderThickness="1" CornerRadius="4" Padding="15,10" Background="White">
                                    <TextBox x:Name="txtTransQty" md:TextFieldAssist.DecorationVisibility="Collapsed" md:HintAssist.Hint="Ví dụ: 10.5" md:HintAssist.IsFloating="False" Foreground="#2D3748" FontSize="15" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,35">
                                <TextBlock Text="5. Lý do xuất hủy / Ghi chú đơn hàng" Foreground="#4A5568" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                <Border BorderBrush="#8993A4" BorderThickness="1" CornerRadius="4" Padding="15,10" Background="White">
                                    <TextBox x:Name="txtTransNotes" md:TextFieldAssist.DecorationVisibility="Collapsed" md:HintAssist.Hint="Nhập nội dung ghi chú..." md:HintAssist.IsFloating="False" Foreground="#2D3748" FontSize="15" MinLines="3" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <Button x:Name="btnCreateTransaction" Click="BtnCreateTransaction_Click" Height="50" Width="280" HorizontalAlignment="Center" Background="#2B6CB0" BorderThickness="0" Cursor="Hand" md:ButtonAssist.CornerRadius="25">
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.2" Color="#2B6CB0"/>
                                </Button.Effect>
                                <TextBlock Text="TẠO PHIẾU GIAO DỊCH" FontWeight="Black" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
