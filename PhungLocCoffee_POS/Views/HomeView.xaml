<UserControl x:Class="PhungLocCoffee_POS.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 4 KPI Cards -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,25">
            <!-- Doanh thu hôm nay -->
            <Border Background="White" CornerRadius="20" Margin="0,0,15,0" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.03"/>
                </Border.Effect>
                <StackPanel>
                    <icon:PackIconMaterial Kind="CurrencyUsd" Foreground="#48BB78" Width="24" Height="24"/>
                    <TextBlock Text="Doanh thu hôm nay" Foreground="#A0AEC0" FontSize="13" Margin="0,15,0,5" FontWeight="Medium"/>
                    <TextBlock Text="{Binding TodayRevenue, StringFormat={}{0:N0} đ}" Foreground="#2D3748" FontSize="22" FontWeight="Black"/>
                </StackPanel>
            </Border>

            <!-- Lượng khách phục vụ -->
            <Border Background="White" CornerRadius="20" Margin="0,0,15,0" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.03"/>
                </Border.Effect>
                <StackPanel>
                    <icon:PackIconMaterial Kind="AccountGroupOutline" Foreground="#3182CE" Width="24" Height="24"/>
                    <TextBlock Text="Lượng khách phục vụ" Foreground="#A0AEC0" FontSize="13" Margin="0,15,0,5" FontWeight="Medium"/>
                    <TextBlock Text="{Binding TodayCustomers, StringFormat={}{0:N0} khách}" Foreground="#2D3748" FontSize="22" FontWeight="Black"/>
                </StackPanel>
            </Border>

            <!-- Đơn chờ đồng bộ -->
            <Border Background="White" CornerRadius="20" Margin="0,0,15,0" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.03"/>
                </Border.Effect>
                <StackPanel>
                    <icon:PackIconMaterial Kind="CloudSyncOutline" Foreground="#E53E3E" Width="24" Height="24"/>
                    <TextBlock Text="Đơn chờ đồng bộ" Foreground="#A0AEC0" FontSize="13" Margin="0,15,0,5" FontWeight="Medium"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PendingSyncOrders, StringFormat={}{0} đơn}" Foreground="#E53E3E" FontSize="22" FontWeight="Black"/>
                        <Border Background="#FFF5F5" Padding="6,2" CornerRadius="6" Margin="10,0,0,0" VerticalAlignment="Center" 
                                Visibility="{Binding IsOfflineMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="OFFLINE" Foreground="#E53E3E" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hệ thống chi nhánh -->
            <Border Background="White" CornerRadius="20" Margin="0" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.03"/>
                </Border.Effect>
                <StackPanel>
                    <icon:PackIconMaterial Kind="HomeCityOutline" Foreground="#D7A16A" Width="24" Height="24"/>
                    <TextBlock Text="Hệ thống chi nhánh" Foreground="#A0AEC0" FontSize="13" Margin="0,15,0,5" FontWeight="Medium"/>
                    <TextBlock Text="{Binding TotalBranches, StringFormat={}{0} chi nhánh}" Foreground="#2D3748" FontSize="22" FontWeight="Black"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Khu vực biểu đồ và cảnh báo tồn kho -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Biểu đồ (giữ nguyên) -->
            <Border Grid.Column="0" Background="White" CornerRadius="25" Margin="0,0,20,0" Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.02"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="NHỊP ĐỘ BÁN HÀNG" FontSize="14" FontWeight="Black" Foreground="#2D3748"/>
                        <TextBlock Text="Dữ liệu theo giờ trong ngày (Real-time)" FontSize="12" Foreground="#A0AEC0" Margin="0,3,0,0"/>
                    </StackPanel>

                    <lvc:CartesianChart Grid.Row="1" Series="{Binding SalesSeries}" LegendLocation="None" Margin="0,10,0,0">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Khung giờ" Labels="{Binding TimeLabels}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1" IsEnabled="False"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>

                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Doanh thu (VNĐ)" LabelFormatter="{Binding MoneyFormatter}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- Cảnh báo tồn kho - Dynamic với ItemsControl -->
            <Border Grid.Column="1" Background="White" CornerRadius="25" Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.02"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CẢNH BÁO TỒN KHO" FontSize="14" FontWeight="Black" Foreground="#2D3748" Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding LowStockAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Màu nền và viền sẽ thay đổi theo mức độ cảnh báo (nếu có property Severity) -->
                                    <Border CornerRadius="12" Padding="15" Margin="0,0,0,12" 
                                            BorderThickness="1"
                                            Background="{Binding BackgroundColor, FallbackValue=#FFF5F5}"
                                            BorderBrush="{Binding BorderColor, FallbackValue=#FED7D7}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ItemName}" FontWeight="Bold" 
                                                       Foreground="{Binding TitleForeground, FallbackValue=#C53030}" 
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding StatusMessage}" 
                                                       Foreground="{Binding MessageForeground, FallbackValue=#E53E3E}" 
                                                       FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="XEM TẤT CẢ" Background="#EDF2F7" BorderThickness="0" 
                            Foreground="#4A5568" FontWeight="Bold" FontSize="11" Height="36" 
                            md:ButtonAssist.CornerRadius="10" Cursor="Hand"
                            Command="{Binding ViewAllLowStockCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
