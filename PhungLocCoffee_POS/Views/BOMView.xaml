<UserControl x:Class="PhungLocCoffee_POS.Views.BOMView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="UserControl_Loaded"
             Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Cột trái: Danh sách Sản phẩm -->
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="20" />
            <!-- Khoảng cách -->
            <!-- Cột phải: Chi tiết công thức -->
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- DANH SÁCH MÓN (PRODUCTS) -->
        <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DANH SÁCH MÓN UỐNG" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                <TextBox x:Name="txtSearchProduct"
                 Grid.Row="1"
                 materialDesign:HintAssist.Hint="Tìm kiếm món..."
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Margin="0,0,0,15"
                 TextChanged="txtSearchProduct_TextChanged"/>

                <DataGrid Grid.Row="2" x:Name="dgProducts" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True"
                          SelectionChanged="dgProducts_SelectionChanged"
                          HeadersVisibility="Column" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Món" Binding="{Binding ProductID}" Width="100"/>
                        <DataGridTextColumn Header="Tên Món" Binding="{Binding ProductName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- CHI TIẾT CÔNG THỨC (RECIPES / BOM) -->
        <materialDesign:Card Grid.Column="2" UniformCornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtRecipeHeader" Text="CÔNG THỨC PHA CHẾ: [CHỌN MỘT MÓN]" 
                           FontSize="18" FontWeight="Bold" Foreground="#D7A16A" Margin="0,0,0,15"/>

                <!-- Form Thêm Nguyên liệu vào Công thức -->
                <Grid Grid.Row="1" Margin="0,0,0,15" IsEnabled="{Binding IsProductSelected, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" x:Name="cbIngredients" materialDesign:HintAssist.Hint="Chọn Nguyên liệu..."
                              DisplayMemberPath="IngredientName" SelectedValuePath="IngredientID"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1" x:Name="txtQuantity" materialDesign:HintAssist.Hint="Định lượng"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,10,0"/>

                    <Button Grid.Column="2" Content="Cập nhật" Click="btnAddIngredient_Click"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#D7A16A"  Foreground="White"/>
                </Grid>

                <!-- Bảng danh sách nguyên liệu của món hiện tại -->
                <DataGrid Grid.Row="2" x:Name="dgRecipeDetails" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50" CanUserSort="False"/>
                        <DataGridTextColumn Header="Tên Nguyên Liệu" Binding="{Binding IngredientName}" Width="*"/>
                        <DataGridTextColumn Header="Định lượng" Binding="{Binding Quantity}" Width="100"/>
                        <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="100"/>

                        <DataGridTemplateColumn Header="Thao tác" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Xóa" Click="btnDeleteIngredient_Click" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                                            Foreground="Red" BorderBrush="Red" Height="25" Padding="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
