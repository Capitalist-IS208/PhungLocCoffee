<Window x:Class="PhungLocCoffee_POS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Đăng nhập hệ thống - Phụng Lộc Coffee" 
        Height="768" Width="1366"
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized"
        MinHeight="720" MinWidth="1024"
        Background="#F4F7F6">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="WatermarkTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <TextBlock x:Name="WatermarkText" 
                                       Text="{TemplateBinding Tag}" 
                                       Foreground="#A0AEC0" FontSize="15" FontWeight="Medium" 
                                       VerticalAlignment="Center" Margin="5,0,0,0" 
                                       Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FEF9F0" Offset="0"/>
                <GradientStop Color="#F2E5D5" Offset="0.5"/>
                <GradientStop Color="#EAD5B8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Viewbox Opacity="0.08" Stretch="Fill">
            <Grid Width="1366" Height="768">
                <icon:PackIconMaterial Kind="Coffee" Width="80" Height="80" Margin="80,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.5"/>
                <icon:PackIconMaterial Kind="Coffee" Width="60" Height="60" Margin="200,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.4"/>
                <icon:PackIconMaterial Kind="Coffee" Width="100" Height="100" Margin="0,500,150,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.6"/>
                <icon:PackIconMaterial Kind="Coffee" Width="70" Height="70" Margin="0,300,80,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.3"/>
                <icon:PackIconMaterial Kind="Coffee" Width="120" Height="120" Margin="50,0,0,80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.4"/>
                <icon:PackIconMaterial Kind="Coffee" Width="90" Height="90" Margin="0,200,250,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.5"/>
            </Grid>
        </Viewbox>

        <Border Width="1000" Height="620" CornerRadius="40" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="50" ShadowDepth="10" Color="Black" Opacity="0.15" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4.5*"/>
                    <ColumnDefinition Width="5.5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="40,0,0,40" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D7A16A" Offset="0"/>
                            <GradientStop Color="#B7791F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse Width="400" Height="400" Fill="White" Opacity="0.08" Margin="-100,-150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Ellipse Width="350" Height="350" Fill="White" Opacity="0.05" Margin="0,0,-150,-150" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <icon:PackIconMaterial Kind="Coffee" Width="180" Height="180" Foreground="White" Opacity="0.1" Margin="0,0,30,30" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="110" Height="110" CornerRadius="35" Margin="0,0,0,25" Background="White" HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Color="#744210" Opacity="0.3"/>
                                </Border.Effect>
                                <icon:PackIconMaterial Kind="Coffee" Foreground="#D7A16A" Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PHỤNG LỘC" Foreground="White" FontSize="44" FontWeight="Black" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="HỆ THỐNG QUẢN LÝ CHUỖI CỬA HÀNG CÀ PHÊ" Foreground="#FFF3E0" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="85"/>
                        <RowDefinition Height="85"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="65"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Phụng Lộc xin chào!" 
                               FontSize="32" FontWeight="Black" Foreground="#2D3748" 
                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Text="Vui lòng đăng nhập để tiếp tục" 
                               FontSize="15" Foreground="#718096" FontWeight="Medium"
                               HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <Border Grid.Row="2" Background="#F7FAFC" CornerRadius="18" BorderThickness="1.5" BorderBrush="#E2E8F0" Height="58" VerticalAlignment="Top" Padding="18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <icon:PackIconMaterial Grid.Column="0" Kind="AccountOutline" Foreground="#A0AEC0" Width="22" Height="22" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource WatermarkTextBox}" Tag="Tên đăng nhập"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" Margin="12,0,0,0" 
                                     Foreground="#2D3748" FontSize="15" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="#F7FAFC" CornerRadius="18" BorderThickness="1.5" BorderBrush="#E2E8F0" Height="58" VerticalAlignment="Top" Padding="18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <icon:PackIconMaterial Grid.Column="0" Kind="LockOutline" Foreground="#A0AEC0" Width="22" Height="22" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock x:Name="txtPasswordWatermark" 
                                           Text="Mật khẩu truy cập" 
                                           Foreground="#A0AEC0" FontSize="15" FontWeight="Medium" 
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <PasswordBox x:Name="txtPassword" 
                                             PasswordChanged="txtPassword_PasswordChanged"
                                             GotFocus="txtPassword_GotFocus"
                                             LostFocus="txtPassword_LostFocus"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" Foreground="#2D3748" 
                                             FontSize="15" FontWeight="SemiBold"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#FFF5F5" CornerRadius="12" Padding="12,8" Height="42" VerticalAlignment="Center"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <icon:PackIconMaterial Kind="AlertCircleOutline" Foreground="#E53E3E" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53E3E" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="5" Height="58" CornerRadius="18" Background="#D7A16A">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Color="#B7791F" Opacity="0.3"/>
                        </Border.Effect>
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnLogin_Click">
                            <Grid>
                                <TextBlock Text="ĐĂNG NHẬP" FontWeight="Black" FontSize="16" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsNotLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <icon:PackIconMaterial Kind="Refresh" Foreground="White" Width="20" Height="20" Spin="True"/>
                                    <TextBlock Text="ĐANG XÁC THỰC..." FontWeight="Black" FontSize="14" Foreground="White" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
