<Window x:Class="PhungLocCoffee_POS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:PhungLocCoffee_POS.Views"
        Title="Phụng Lộc Coffee - POS" Height="768" Width="1024" 
        WindowStartupLocation="CenterScreen" WindowState="Maximized" 
        Background="#F4F7F6"
        MouseDown="Window_MouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="White" Margin="0,0,0,2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal">
                    <!-- Logo -->
                    <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,15,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E2B17D" Offset="0"/>
                                <GradientStop Color="#C08449" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#C08449" Opacity="0.4" Direction="270"/>
                        </Border.Effect>
                        <icon:PackIconMaterial Kind="CoffeeOutline" Foreground="White" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Brand -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PHỤNG LỘC" Foreground="#2D3748" FontSize="22" FontWeight="Black" FontFamily="Segoe UI" Margin="0,0,0,-2"/>
                        <TextBlock Text="C O F F E E   &amp;   T E A" Foreground="#A0AEC0" FontSize="9" FontWeight="Bold" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- Search -->
                    <Grid Margin="60,0,0,0">
                        <Border x:Name="SearchContainer" Background="#EDF2F7" CornerRadius="22" Width="380" Height="44" Padding="15,0">
                            <DockPanel>
                                <icon:PackIconMaterial Kind="Magnify" Foreground="#A0AEC0" VerticalAlignment="Center" DockPanel.Dock="Left" Width="20" Height="20"/>
                                <TextBox x:Name="txtSearch" md:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#A0AEC0" 
                                         Text="Tìm món hoặc nguyên liệu..." FontSize="14"
                                         GotKeyboardFocus="txtSearch_GotFocus" 
                                         LostKeyboardFocus="txtSearch_LostFocus"
                                         KeyDown="txtSearch_KeyDown"/>
                            </DockPanel>
                        </Border>

                        <Popup x:Name="SearchNotificationPopup" PlacementTarget="{Binding ElementName=SearchContainer}" Placement="Bottom" AllowsTransparency="True" VerticalOffset="8" StaysOpen="False">
                            <Border Background="White" Width="380" CornerRadius="16" Padding="15,10,15,10" BorderThickness="1" BorderBrush="#E2E8F0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#FFF5F5" Width="32" Height="32" CornerRadius="16">
                                        <icon:PackIconMaterial Kind="AlertCircleOutline" Foreground="#F56565" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,10,0" VerticalAlignment="Center" Width="270">
                                        <TextBlock Text="Kết quả tìm kiếm" FontWeight="ExtraBold" FontSize="13" Foreground="#2D3748"/>
                                        <TextBlock x:Name="txtNotificationMessage" Text="Không có dữ liệu khớp với từ khóa." FontSize="12" Foreground="#718096" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Right side: Clock & Admin -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                        <icon:PackIconMaterial Kind="ClockOutline" Foreground="#A0AEC0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <!-- BINDING: thời gian thực -->
                        <TextBlock Text="{Binding CurrentTime}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                    </StackPanel>

                    <!-- Admin Container -->
                    <Border x:Name="AdminContainer" 
                            BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="22" 
                            PreviewMouseLeftButtonDown="AdminContainer_PreviewMouseLeftButtonDown"
                            Padding="6,6,15,6" Background="White" Cursor="Hand" 
                            MouseLeftButtonUp="AdminContainer_MouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#2D3748">
                                <!-- Avatar ký tự -->
                                <TextBlock Text="{Binding AvatarChar}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                            </Border>
                            <!-- Tên hiển thị rút gọn -->
                            <TextBlock Text="{Binding ShortName}" VerticalAlignment="Center" Margin="12,0,8,0" FontWeight="Bold" Foreground="#2D3748" FontSize="14"/>
                            <icon:PackIconMaterial Kind="ChevronDown" VerticalAlignment="Center" Foreground="#A0AEC0" Width="16" Height="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" Margin="0,0,2,0" Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="0" Opacity="0.03" Color="Black"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="0,20">
                    <Border x:Name="btnHome" Background="#FFF7EB" CornerRadius="18" Margin="10,5" Padding="0,15" Cursor="Hand" 
                            MouseLeftButtonUp="MenuHome_Click">
                        <StackPanel>
                            <icon:PackIconMaterial x:Name="iconHome" Kind="HomeVariant" HorizontalAlignment="Center" Width="26" Height="26" Foreground="#D7A16A"/>
                            <TextBlock x:Name="txtHome" Text="TRANG CHỦ" FontSize="11" Margin="0,8,0,0" FontWeight="Bold" Foreground="#D7A16A" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="btnSales" Background="Transparent" CornerRadius="18" Margin="10,5" Padding="0,15" Cursor="Hand" 
                            MouseLeftButtonUp="MenuSales_Click">
                        <StackPanel>
                            <icon:PackIconMaterial x:Name="iconSales" Kind="CoffeeMaker" HorizontalAlignment="Center" Width="26" Height="26" Foreground="#A0AEC0"/>
                            <TextBlock x:Name="txtSales" Text="BÁN HÀNG" FontSize="11" Margin="0,8,0,0" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="btnInventory" Background="Transparent" CornerRadius="18" Margin="10,5" Padding="0,15" Cursor="Hand" 
                            MouseLeftButtonUp="MenuInventory_Click">
                        <StackPanel>
                            <icon:PackIconMaterial x:Name="iconInventory" Kind="Archive" HorizontalAlignment="Center" Width="26" Height="26" Foreground="#A0AEC0"/>
                            <TextBlock x:Name="txtInventory" Text="KHO HÀNG" FontSize="11" Margin="0,8,0,0" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

        
                    <Border x:Name="btnBOM" Background="Transparent" CornerRadius="18" Margin="10,5" Padding="0,15" Cursor="Hand" 
                            MouseLeftButtonUp="MenuBOM_Click">
                        <StackPanel>
                            <icon:PackIconMaterial x:Name="iconBOM" Kind="TextBoxOutline" HorizontalAlignment="Center" Width="26" Height="26" Foreground="#A0AEC0"/>
                            <TextBlock x:Name="txtBOM" Text="CÔNG THỨC" FontSize="11" Margin="0,8,0,0" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="btnSuppliers" Background="Transparent" CornerRadius="18" Margin="10,5" Padding="0,15" Cursor="Hand" 
        MouseLeftButtonUp="MenuSuppliers_Click">
                        <StackPanel>
                            <icon:PackIconMaterial x:Name="iconSuppliers" Kind="TruckOutline" HorizontalAlignment="Center" Width="26" Height="26" Foreground="#A0AEC0"/>
                            <TextBlock x:Name="txtSuppliers" Text="NHÀ CUNG CẤP" FontSize="11" Margin="0,8,0,0" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="btnReports" Background="Transparent" CornerRadius="18" Margin="10,5" Padding="0,15" Cursor="Hand" 
                    MouseLeftButtonUp="MenuReports_Click">
                        <StackPanel>
                            <icon:PackIconMaterial x:Name="iconReports" Kind="ChartBar" HorizontalAlignment="Center" Width="26" Height="26" Foreground="#A0AEC0"/>
                            <TextBlock x:Name="txtReports" Text="BÁO CÁO" FontSize="11" Margin="0,8,0,0" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Grid.Column="1" x:Name="MainContent">
        </Grid>

        <!-- Admin Popup -->
        <Popup x:Name="AdminPopup" 
               PlacementTarget="{Binding ElementName=AdminContainer}" 
               Placement="Bottom" 
               AllowsTransparency="True" 
               VerticalOffset="12" 
               HorizontalOffset="-125" 
               StaysOpen="True">
            <Border Background="White" Width="280" CornerRadius="16" Padding="20" BorderThickness="1" BorderBrush="#E2E8F0">
                <StackPanel>
                    <!-- Avatar + thông tin user -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="42" Height="42" CornerRadius="21" Background="#FAF6F2" Margin="0,0,12,0">
                            <TextBlock Text="{Binding AvatarChar}" Foreground="#D7A16A" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="ExtraBold" Foreground="#2D3748"/>
                            <TextBlock Text="{Binding RoleAndBranch}" FontSize="12" Foreground="#A0AEC0" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="#F1F5F9" Margin="0,15"/>

                    <!-- Trạng thái ca trực -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="TRẠNG THÁI CA TRỰC" FontSize="11" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,0,0,8"/>
                        <Grid>
                            <icon:PackIconMaterial Kind="ClockCheckOutline" Foreground="#48BB78" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentShiftStatus}" Margin="26,0,0,0" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Đơn chờ đồng bộ -->
                    <Border Background="#FFF5F5" CornerRadius="12" Padding="12" Margin="0,0,0,18" BorderThickness="1" BorderBrush="#FED7D7">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#E53E3E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding PendingOfflineOrders, StringFormat={}{0} đơn chờ đồng bộ}" FontSize="13" FontWeight="Bold" Foreground="#E53E3E" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="Gửi ngay"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#E53E3E"
                            BorderThickness="0"
                            Height="24"
                            Padding="10,0"
                            md:ButtonAssist.CornerRadius="6"
                            Click="BtnSyncNow_Click"/>
                        </Grid>
                    </Border>

                    <!-- Nút đăng xuất -->
                    <Button Height="44" 
                            md:ButtonAssist.CornerRadius="10" 
                            Background="Transparent" 
                            BorderBrush="#E2E8F0" 
                            BorderThickness="1.5" 
                            Click="Logout_Click" 
                            Cursor="Hand" 
                            md:ElevationAssist.Elevation="Dp0">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="Logout" Width="18" Height="18" Foreground="#E53E3E" VerticalAlignment="Center"/>
                            <TextBlock Text="ĐĂNG XUẤT HỆ THỐNG" Margin="10,0,0,0" FontWeight="Black" FontSize="12" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
