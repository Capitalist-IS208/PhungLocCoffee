<UserControl x:Class="PhungLocCoffee_POS.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             Background="Transparent">

    <Grid Margin="15,0,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="OverlayLoading" Grid.RowSpan="2" Background="#99FFFFFF" Panel.ZIndex="100" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="50" Height="50" Foreground="#48BB78"/>
                <TextBlock Text="Đang tải dữ liệu..." FontWeight="Bold" FontSize="16" Foreground="#2D3748" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Border Background="White" CornerRadius="12" Height="45" Padding="15,0" Margin="0,0,15,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="CalendarRange" Foreground="#D7A16A" VerticalAlignment="Center" Width="18" Height="18"/>
                        <ComboBox x:Name="cboTimeFilter" SelectedIndex="2" SelectionChanged="CboTimeFilter_SelectionChanged"
                                  Background="Transparent" BorderThickness="0" Foreground="#2D3748"
                                  FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" Width="180">
                            <ComboBoxItem Content="Hôm nay"/>
                            <ComboBoxItem Content="7 ngày qua"/>
                            <ComboBoxItem Content="Tháng này"/>
                            <ComboBoxItem Content="Tháng trước"/>
                            <ComboBoxItem Content="Quý này"/>
                            <ComboBoxItem Content="Năm nay"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Height="45" Padding="15,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.03" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="StorefrontOutline" Foreground="#A0AEC0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <ComboBox x:Name="cboBranchFilter" SelectionChanged="CboBranchFilter_SelectionChanged"
                                  Background="Transparent" BorderThickness="0" Foreground="#4A5568"
                                  FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" Width="160"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Height="45" Background="#48BB78" BorderThickness="0" Foreground="White" 
                        FontWeight="Bold" FontSize="13" md:ButtonAssist.CornerRadius="12" 
                        Cursor="Hand" Padding="20,0" Click="BtnRefresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="Refresh" Foreground="White" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="LÀM MỚI" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Height="45" Background="#4299E1" BorderThickness="0" Foreground="White" 
                        FontWeight="Bold" FontSize="13" md:ButtonAssist.CornerRadius="12" 
                        Cursor="Hand" Padding="20,0" Margin="10,0,0,0" Click="BtnExportPdf_Click">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="FilePdfBox" Foreground="White" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="XUẤT PDF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="20" Padding="20" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.04" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="1. DOANH THU THEO CHI NHÁNH" FontSize="16" FontWeight="Black" Foreground="#2D3748" Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" x:Name="dgRevenue" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" 
                              BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="None" HeadersVisibility="Column"
                              RowHeight="45" FontSize="14" Foreground="#2D3748" Margin="0,0,0,20">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="0,0,0,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÊN CHI NHÁNH" Binding="{Binding BranchName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SỐ ĐƠN" Binding="{Binding OrderCount}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TỔNG DOANH THU" Binding="{Binding TotalRevenue, StringFormat={}{0:N0} đ}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#D7A16A"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <lvc:CartesianChart Grid.Row="2" x:Name="ChartRevenue" Series="{Binding RevenueSeries}" LegendLocation="None" Margin="0,10,0,0" AnimationsSpeed="0:0:0.8">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding BranchLabels}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1" IsEnabled="False"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis LabelFormatter="{Binding MoneyFormatter}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="20" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.04" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="2. PHÂN TÍCH TỶ LỆ HAO HỤT KHO" FontSize="16" FontWeight="Black" Foreground="#2D3748"/>
                        <TextBlock Text="KPI Mục tiêu: Lãng phí nguyên liệu &lt; 2%" FontSize="13" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgWaste" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" 
                              BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="None" HeadersVisibility="Column"
                              RowHeight="50" FontSize="14" Foreground="#2D3748">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="0,0,0,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NGUYÊN LIỆU" Binding="{Binding ItemName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="HỆ THỐNG" Binding="{Binding SystemQty}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="THỰC TẾ" Binding="{Binding ActualQty}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="LỆCH" Binding="{Binding Difference}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="TỶ LỆ (%)" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BgColor}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WasteRateText}" Foreground="{Binding TextColor}" FontWeight="Black" FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>